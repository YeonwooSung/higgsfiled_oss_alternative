# --- API / worker (prefix OC_) ---
OC_SIGNING_SECRET=change-me-to-a-long-random-string
# Mock profile works without a GPU; switch to open_weights_v1 once the Comfy deployment is integrated.
OC_DEFAULT_PROFILE=mock_v1
# None of the three tools has open_weights_v1 yet (Comfy graphs not exported; Camera Sketch control presets uncalibrated); keep mock_v1.
# Web: the studio on :3000 (also the origin MinIO CORS allows via MINIO_API_CORS_ALLOW_ORIGIN in infra/docker-compose.yml).
# Set to true behind HTTPS.
OC_COOKIE_SECURE=false
OC_PUBLIC_BASE_URL=http://localhost:3000
# local (default, served through the API) or s3 (MinIO / S3 presigned URLs)
# Compose MinIO (`--profile s3`): OC_STORAGE_BACKEND=s3, OC_S3_ENDPOINT_URL=http://minio:9000,
# OC_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000, and set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY.
OC_STORAGE_BACKEND=local
OC_S3_BUCKET=open-creative
OC_S3_ENDPOINT_URL=
# Endpoint the browser uses for presigned URLs, when it differs from OC_S3_ENDPOINT_URL (empty = same).
OC_S3_PUBLIC_ENDPOINT_URL=
# Origin(s) allowed by the compose MinIO (`--profile s3`); comma-separated. Must match where the studio is served.
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:3000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Comfy API deployment (server-side only; never sent to the browser) ---
# Deployment endpoint from the Comfy Developer Platform, or the local v2 proxy (http://127.0.0.1:8189).
COMFY_BASE_URL=
COMFY_API_KEY=

# --- Pocket VFX (mock profile only) ---
# Directory with the Pocket VFX fixture clips + ground-truth masks the mock mask provider matches clips against.
# Default: <repo>/fixtures/pocket-vfx. Clips that match no fixture get deterministic GrabCut masks.
# OC_VFX_FIXTURES=
