FROM node:20-slim AS build
RUN corepack enable
# Next.js resolves rewrites at build time, so the API origin is a build argument.
ARG API_ORIGIN=http://api:8000
ENV API_ORIGIN=$API_ORIGIN
# Which app to build and serve (apps/<APP>, package @oc/<APP>) and its port. The only app is the studio.
ARG APP=studio
ARG PORT=3000
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages packages
# packages/ includes @oc/web-core and @oc/ui, which the studio imports.
COPY apps/${APP} apps/${APP}
RUN pnpm install --frozen-lockfile --filter "@oc/${APP}..." && pnpm --filter "@oc/${APP}" build

FROM node:20-slim
RUN corepack enable
ARG APP=studio
ARG PORT=3000
WORKDIR /app
COPY --from=build /app /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 APP=$APP
EXPOSE $PORT
# The studio's `start` script pins port 3000.
CMD ["sh", "-c", "exec pnpm --filter @oc/$APP start"]
