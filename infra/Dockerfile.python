# API and worker share one image; the compose command picks the role.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.10.11 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY nodes/open_creative nodes/open_creative
COPY services services
COPY presets presets
COPY models models
COPY workflows workflows
# Mock depth ground truth for the bundled Camera Sketch samples (MockRunner matches uploads by hash), so the
# mock_v1 profile in the image returns the same depth as local dev. Only the scene manifest + images (~2.6 MB).
COPY fixtures/camera-sketch/scenes.json fixtures/camera-sketch/*.png fixtures/camera-sketch/
RUN uv sync --frozen --no-dev
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["uvicorn", "oc_api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
